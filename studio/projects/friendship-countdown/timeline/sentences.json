[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.46,
  "text": "Your best friend's number says 41."
 },
 {
  "i": 1,
  "start": 2.94,
  "end": 4.86,
  "text": "It's floating right above Kabir's head."
 },
 {
  "i": 2,
  "start": 5.42,
  "end": 5.7,
  "text": "Small."
 },
 {
  "i": 3,
  "start": 6.2,
  "end": 6.54,
  "text": "White."
 },
 {
  "i": 4,
  "start": 7.06,
  "end": 7.42,
  "text": "Glowing."
 },
 {
  "i": 5,
  "start": 7.42,
  "end": 9.56,
  "text": "Forty-one."
 },
 {
  "i": 6,
  "start": 9.56,
  "end": 9.82,
  "text": "You blink."
 },
 {
  "i": 7,
  "start": 10.44,
  "end": 11.36,
  "text": "It doesn't go away."
 },
 {
  "i": 8,
  "start": 11.86,
  "end": 13.36,
  "text": "You look around the college canteen."
 },
 {
  "i": 9,
  "start": 13.92,
  "end": 14.92,
  "text": "Everyone has one."
 },
 {
  "i": 10,
  "start": 14.92,
  "end": 16.32,
  "text": "Riya from your class"
 },
 {
  "i": 11,
  "start": 17.24,
  "end": 17.88,
  "text": "2,300."
 },
 {
  "i": 12,
  "start": 18.34,
  "end": 21.2,
  "text": "The guy who borrowed your charger once 3."
 },
 {
  "i": 13,
  "start": 21.68,
  "end": 24.48,
  "text": "Your mom, on a video call no number at all."
 },
 {
  "i": 14,
  "start": 25.04,
  "end": 26.66,
  "text": "Just a warm, gold light."
 },
 {
  "i": 15,
  "start": 27.2,
  "end": 28.9,
  "text": "And slowly, you understand."
 },
 {
  "i": 16,
  "start": 29.4,
  "end": 32.54,
  "text": "Every number is how many days that friendship has left."
 },
 {
  "i": 17,
  "start": 33.02,
  "end": 34.44,
  "text": "At first, it's a superpower."
 },
 {
  "i": 18,
  "start": 35.1,
  "end": 37.16,
  "text": "That fake friend who only texts when he needs notes?"
 },
 {
  "i": 19,
  "start": 37.16,
  "end": 38.14,
  "text": "Twelve days."
 },
 {
  "i": 20,
  "start": 38.62,
  "end": 40.3,
  "text": "You stop helping him and you're right."
 },
 {
  "i": 21,
  "start": 40.7,
  "end": 41.1,
  "text": "He disappears."
 },
 {
  "i": 22,
  "start": 41.9,
  "end": 43.46,
  "text": "The girl who sits alone in the library?"
 },
 {
  "i": 23,
  "start": 43.9,
  "end": 45.56,
  "text": "Her number with you is huge."
 },
 {
  "i": 24,
  "start": 45.56,
  "end": 47.44,
  "text": "Eleven thousand days."
 },
 {
  "i": 25,
  "start": 47.44,
  "end": 48.7,
  "text": "Thirty years."
 },
 {
  "i": 26,
  "start": 49.26,
  "end": 49.88,
  "text": "You say hi."
 },
 {
  "i": 27,
  "start": 50.28,
  "end": 52.14,
  "text": "She becomes the funniest person you know."
 },
 {
  "i": 28,
  "start": 52.48,
  "end": 53.68,
  "text": "And here's the strange part."
 },
 {
  "i": 29,
  "start": 54.08,
  "end": 54.98,
  "text": "It's real science."
 },
 {
  "i": 30,
  "start": 55.46,
  "end": 62.64,
  "text": "Researchers found it takes around fifty hours to turn a stranger into a casual friend and more than two hundred hours to make a close one."
 },
 {
  "i": 31,
  "start": 63.04,
  "end": 63.98,
  "text": "Friendship isn't luck."
 },
 {
  "i": 32,
  "start": 64.5,
  "end": 64.96,
  "text": "It's time."
 },
 {
  "i": 33,
  "start": 65.54,
  "end": 67.36,
  "text": "So you start spending time like money."
 },
 {
  "i": 34,
  "start": 67.86,
  "end": 69.54,
  "text": "But Kabir's number keeps falling."
 },
 {
  "i": 35,
  "start": 70.12,
  "end": 70.3,
  "text": "41."
 },
 {
  "i": 36,
  "start": 70.92,
  "end": 71.42,
  "text": "30."
 },
 {
  "i": 37,
  "start": 71.88,
  "end": 72.48,
  "text": "22."
 },
 {
  "i": 38,
  "start": 73.02,
  "end": 74.56,
  "text": "You've known him since you were seven."
 },
 {
  "i": 39,
  "start": 74.98,
  "end": 75.9,
  "text": "Cricket in the gully."
 },
 {
  "i": 40,
  "start": 76.26,
  "end": 76.94,
  "text": "Exam nights."
 },
 {
  "i": 41,
  "start": 77.28,
  "end": 80.2,
  "text": "The worst haircut of your life, and he still said it looked fine."
 },
 {
  "i": 42,
  "start": 80.56,
  "end": 82.68,
  "text": "What could possibly end in 22 days?"
 },
 {
  "i": 43,
  "start": 83.28,
  "end": 84.32,
  "text": "You try everything."
 },
 {
  "i": 44,
  "start": 84.78,
  "end": 88.1,
  "text": "Free food, movie nights, old memes at 2 a.m."
 },
 {
  "i": 45,
  "start": 88.1,
  "end": 89.36,
  "text": "The number doesn't move."
 },
 {
  "i": 46,
  "start": 89.72,
  "end": 90.96,
  "text": "And you notice something else."
 },
 {
  "i": 47,
  "start": 91.5,
  "end": 93.32,
  "text": "Your numbers with everyone are shrinking."
 },
 {
  "i": 48,
  "start": 93.82,
  "end": 97.34,
  "text": "Because you're so busy checking numbers you've stopped actually listening."
 },
 {
  "i": 49,
  "start": 97.88,
  "end": 102.46,
  "text": "A famous Dutch study found people lose about half of their close friends every seven years."
 },
 {
  "i": 50,
  "start": 102.92,
  "end": 103.76,
  "text": "Not because of fights."
 },
 {
  "i": 51,
  "start": 104.2,
  "end": 105.02,
  "text": "Because of silence."
 },
 {
  "i": 52,
  "start": 105.64,
  "end": 106.94,
  "text": "Friendships rarely explode."
 },
 {
  "i": 53,
  "start": 107.58,
  "end": 108.02,
  "text": "They fade."
 },
 {
  "i": 54,
  "start": 108.62,
  "end": 111.7,
  "text": "Then, on day 3, Kabir finally says it."
 },
 {
  "i": 55,
  "start": 112.12,
  "end": 113.24,
  "text": "\"I got the job in Canada."
 },
 {
  "i": 56,
  "start": 113.7,
  "end": 114.52,
  "text": "I leave on Sunday."
 },
 {
  "i": 57,
  "start": 115.14,
  "end": 116.18,
  "text": "I didn't know how to tell you.\""
 },
 {
  "i": 58,
  "start": 116.52,
  "end": 117.28,
  "text": "That's the number."
 },
 {
  "i": 59,
  "start": 117.28,
  "end": 118.36,
  "text": "Not a fight."
 },
 {
  "i": 60,
  "start": 118.7,
  "end": 119.34,
  "text": "A flight."
 },
 {
  "i": 61,
  "start": 120.02,
  "end": 120.76,
  "text": "Three days."
 },
 {
  "i": 62,
  "start": 121.48,
  "end": 122.2,
  "text": "You could be angry."
 },
 {
  "i": 63,
  "start": 122.62,
  "end": 123.76,
  "text": "You could act like it doesn't matter."
 },
 {
  "i": 64,
  "start": 124.16,
  "end": 127.36,
  "text": "Instead, you do the only thing the number never measured."
 },
 {
  "i": 65,
  "start": 127.82,
  "end": 128.54,
  "text": "You show up."
 },
 {
  "i": 66,
  "start": 128.92,
  "end": 134.52,
  "text": "Day 3, you skip class and you play cricket in the old gully, two grown men in the rain, laughing like idiots."
 },
 {
  "i": 67,
  "start": 135.06,
  "end": 138.92,
  "text": "Day 2, you write down every stupid memory you have and put it in his bag."
 },
 {
  "i": 68,
  "start": 139.32,
  "end": 140.58,
  "text": "Day 1, the airport."
 },
 {
  "i": 69,
  "start": 140.98,
  "end": 143.14,
  "text": "He hugs you so hard your glasses break."
 },
 {
  "i": 70,
  "start": 143.48,
  "end": 145.56,
  "text": "And at the gate, his number flickers."
 },
 {
  "i": 71,
  "start": 145.56,
  "end": 146.4,
  "text": "0."
 },
 {
  "i": 72,
  "start": 146.4,
  "end": 147.7,
  "text": "Then it changes."
 },
 {
  "i": 73,
  "start": 148.2,
  "end": 150.68,
  "text": "It becomes a symbol you've never seen before."
 },
 {
  "i": 74,
  "start": 151.28,
  "end": 152.34,
  "text": "An infinity sign."
 },
 {
  "i": 75,
  "start": 152.8,
  "end": 153.74,
  "text": "Glowing gold."
 },
 {
  "i": 76,
  "start": 154.28,
  "end": 155.98,
  "text": "The same light as your mom's."
 },
 {
  "i": 77,
  "start": 156.0,
  "end": 157.6,
  "text": "Because some friendships don't end."
 },
 {
  "i": 78,
  "start": 158.06,
  "end": 159.62,
  "text": "They just move to a different time zone."
 },
 {
  "i": 79,
  "start": 160.24,
  "end": 165.34,
  "text": "The longest-running study on happiness, at Harvard, followed people for over eighty years."
 },
 {
  "i": 80,
  "start": 165.9,
  "end": 166.72,
  "text": "Its biggest finding?"
 },
 {
  "i": 81,
  "start": 167.3,
  "end": 170.84,
  "text": "The people who lived the longest, happiest lives weren't the richest."
 },
 {
  "i": 82,
  "start": 171.44,
  "end": 173.2,
  "text": "They were the ones with good relationships."
 },
 {
  "i": 83,
  "start": 173.96,
  "end": 175.1,
  "text": "You walk out of the airport."
 },
 {
  "i": 84,
  "start": 175.1,
  "end": 176.98,
  "text": "You check the mirror in the taxi."
 },
 {
  "i": 85,
  "start": 177.4,
  "end": 179.28,
  "text": "There's a number above your own head."
 },
 {
  "i": 86,
  "start": 179.86,
  "end": 181.0,
  "text": "It's not counting friendships."
 },
 {
  "i": 87,
  "start": 181.64,
  "end": 184.62,
  "text": "It's counting how many days you have left to call the people you miss."
 },
 {
  "i": 88,
  "start": 185.12,
  "end": 188.48,
  "text": "So if you could see it, whose number would you check first?"
 },
 {
  "i": 89,
  "start": 189.1,
  "end": 189.82,
  "text": "Tell me in the comments."
 },
 {
  "i": 90,
  "start": 189.82,
  "end": 191.96,
  "text": "And then maybe call them."
 }
]