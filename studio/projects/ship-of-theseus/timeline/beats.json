[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.08,
  "speechEnd": 4.4,
  "text": "If every part of a ship is replaced, is it still the same ship?",
  "end": 5.29
 },
 {
  "i": 1,
  "start": 5.29,
  "speechStart": 5.44,
  "speechEnd": 8.46,
  "text": "Ancient Athens kept the ship of the hero Theseus.",
  "end": 8.83
 },
 {
  "i": 2,
  "start": 8.83,
  "speechStart": 8.98,
  "speechEnd": 12.18,
  "text": "When an old plank rotted, they swapped in fresh timber.",
  "end": 12.55
 },
 {
  "i": 3,
  "start": 12.55,
  "speechStart": 12.7,
  "speechEnd": 16.32,
  "text": "One plank at a time. Years went by.",
  "end": 16.65
 },
 {
  "i": 4,
  "start": 16.65,
  "speechStart": 16.8,
  "speechEnd": 20.08,
  "text": "Picture a day with not one original plank left.",
  "end": 20.37
 },
 {
  "i": 5,
  "start": 20.37,
  "speechStart": 20.52,
  "speechEnd": 24.08,
  "text": "The writer Plutarch says philosophers argued about it.",
  "end": 24.33
 },
 {
  "i": 6,
  "start": 24.33,
  "speechStart": 24.48,
  "speechEnd": 26.34,
  "text": "Some said it was the same ship.",
  "end": 26.69
 },
 {
  "i": 7,
  "start": 26.69,
  "speechStart": 26.84,
  "speechEnd": 28.84,
  "text": "Others said it was a new one.",
  "end": 28.69
 },
 {
  "i": 8,
  "start": 28.69,
  "speechStart": 28.84,
  "speechEnd": 31.6,
  "text": "Later, Thomas Hobbes made it harder.",
  "end": 32.03
 },
 {
  "i": 9,
  "start": 32.03,
  "speechStart": 32.18,
  "speechEnd": 36.24,
  "text": "What if someone kept every old plank, and built a second ship from them?",
  "end": 36.57
 },
 {
  "i": 10,
  "start": 36.57,
  "speechStart": 36.72,
  "speechEnd": 38.04,
  "text": "Now there are two ships.",
  "end": 38.47
 },
 {
  "i": 11,
  "start": 38.47,
  "speechStart": 38.62,
  "speechEnd": 41.08,
  "text": "Which one is the real ship of Theseus?",
  "end": 41.61
 },
 {
  "i": 12,
  "start": 41.61,
  "speechStart": 41.76,
  "speechEnd": 43.14,
  "text": "Now think about you.",
  "end": 43.45
 },
 {
  "i": 13,
  "start": 43.45,
  "speechStart": 43.6,
  "speechEnd": 47.1,
  "text": "Your body replaces many of its cells over the years.",
  "end": 47.41
 },
 {
  "i": 14,
  "start": 47.41,
  "speechStart": 47.56,
  "speechEnd": 50.46,
  "text": "Your opinions and your memories change too.",
  "end": 50.99
 },
 {
  "i": 15,
  "start": 50.99,
  "speechStart": 51.14,
  "speechEnd": 54.66,
  "text": "So are you the same person you were ten years ago?",
  "end": 55.07
 },
 {
  "i": 16,
  "start": 55.07,
  "speechStart": 55.22,
  "speechEnd": 56.82,
  "text": "Same ship, or new ship?",
  "end": 56.67
 },
 {
  "i": 17,
  "start": 56.67,
  "speechStart": 56.82,
  "speechEnd": 58.6,
  "text": "Tell me in the comments.",
  "end": 60.121
 }
]