[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.86,
  "text": "You might miss a gorilla walking right in front of you."
 },
 {
  "i": 1,
  "start": 3.06,
  "end": 3.74,
  "text": "Don't believe me?"
 },
 {
  "i": 2,
  "start": 4.02,
  "end": 6.52,
  "text": "Count how many times the players in white pass the ball."
 },
 {
  "i": 3,
  "start": 6.8,
  "end": 7.72,
  "text": "Only the white team."
 },
 {
  "i": 4,
  "start": 8.24,
  "end": 9.06,
  "text": "Ignore the black team."
 },
 {
  "i": 5,
  "start": 9.32,
  "end": 9.86,
  "text": "Keep counting."
 },
 {
  "i": 6,
  "start": 10.22,
  "end": 10.96,
  "text": "Don't lose track."
 },
 {
  "i": 7,
  "start": 13.45,
  "end": 14.01,
  "text": "Okay, stop."
 },
 {
  "i": 8,
  "start": 14.37,
  "end": 15.25,
  "text": "How many did you get?"
 },
 {
  "i": 9,
  "start": 15.45,
  "end": 15.91,
  "text": "It's seven."
 },
 {
  "i": 10,
  "start": 16.17,
  "end": 17.35,
  "text": "But here's the real question."
 },
 {
  "i": 11,
  "start": 17.71,
  "end": 18.51,
  "text": "Did you see the gorilla?"
 },
 {
  "i": 12,
  "start": 18.91,
  "end": 19.59,
  "text": "Let's rewind."
 },
 {
  "i": 13,
  "start": 19.89,
  "end": 22.85,
  "text": "A gorilla walked right through the middle, stopped, and beat its chest."
 },
 {
  "i": 14,
  "start": 23.17,
  "end": 25.21,
  "text": "This is the invisible gorilla experiment."
 },
 {
  "i": 15,
  "start": 25.45,
  "end": 26.15,
  "text": "In 1999,"
 },
 {
  "i": 16,
  "start": 26.97,
  "end": 32.99,
  "text": "two psychologists at Harvard, Daniel Simons and Christopher Chabris, showed people a video just like this."
 },
 {
  "i": 17,
  "start": 33.17,
  "end": 35.05,
  "text": "About half of them never saw the gorilla."
 },
 {
  "i": 18,
  "start": 35.31,
  "end": 36.59,
  "text": "Not because they weren't looking."
 },
 {
  "i": 19,
  "start": 36.73,
  "end": 38.21,
  "text": "Because they were looking too hard."
 },
 {
  "i": 20,
  "start": 38.43,
  "end": 44.17,
  "text": "Your brain can't handle everything your eyes see, so it quietly throws away whatever doesn't matter for the task."
 },
 {
  "i": 21,
  "start": 44.71,
  "end": 46.51,
  "text": "Scientists call it inattentional blindness."
 },
 {
  "i": 22,
  "start": 46.71,
  "end": 48.29,
  "text": "And it's not just a party trick."
 },
 {
  "i": 23,
  "start": 48.49,
  "end": 53.59,
  "text": "It's one reason drivers miss a motorcycle, and why you can't find the keys sitting right in front of you."
 },
 {
  "i": 24,
  "start": 53.73,
  "end": 55.55,
  "text": "So what else are you missing right now?"
 },
 {
  "i": 25,
  "start": 55.83,
  "end": 58.07,
  "text": "Comment your count, and tell me if you saw the gorilla."
 }
]