[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.34,
  "text": "Imagine your dream life."
 },
 {
  "i": 1,
  "start": 1.64,
  "end": 1.88,
  "text": "Forever."
 },
 {
  "i": 2,
  "start": 2.36,
  "end": 2.6,
  "text": "Perfect."
 },
 {
  "i": 3,
  "start": 3.3,
  "end": 4.28,
  "text": "And completely fake."
 },
 {
  "i": 4,
  "start": 4.98,
  "end": 5.64,
  "text": "Would you plug in?"
 },
 {
  "i": 5,
  "start": 5.9,
  "end": 10.38,
  "text": "In 1974, philosopher Robert Nozick dreamed up the Experience Machine."
 },
 {
  "i": 6,
  "start": 10.66,
  "end": 11.42,
  "text": "You lie in a tank."
 },
 {
  "i": 7,
  "start": 11.78,
  "end": 12.88,
  "text": "Wires go into your brain."
 },
 {
  "i": 8,
  "start": 13.14,
  "end": 14.62,
  "text": "And it feeds you any life you want."
 },
 {
  "i": 9,
  "start": 14.96,
  "end": 15.68,
  "text": "Write the bestseller."
 },
 {
  "i": 10,
  "start": 15.9,
  "end": 16.86,
  "text": "Fall in love."
 },
 {
  "i": 11,
  "start": 16.86,
  "end": 17.72,
  "text": "Win the big game."
 },
 {
  "i": 12,
  "start": 18.0,
  "end": 21.46,
  "text": "It feels one hundred percent real, and you'd never know you were plugged in."
 },
 {
  "i": 13,
  "start": 21.7,
  "end": 22.58,
  "text": "So here's the question."
 },
 {
  "i": 14,
  "start": 22.98,
  "end": 23.98,
  "text": "Would you plug in, for life?"
 },
 {
  "i": 15,
  "start": 24.38,
  "end": 25.4,
  "text": "Most people say no."
 },
 {
  "i": 16,
  "start": 25.62,
  "end": 26.26,
  "text": "Which is weird."
 },
 {
  "i": 17,
  "start": 26.5,
  "end": 29.92,
  "text": "Because if happiness were all we wanted, this machine would be perfect."
 },
 {
  "i": 18,
  "start": 30.42,
  "end": 31.04,
  "text": "Nozick's answer?"
 },
 {
  "i": 19,
  "start": 31.42,
  "end": 33.12,
  "text": "We don't just want to feel like we did something."
 },
 {
  "i": 20,
  "start": 33.48,
  "end": 34.7,
  "text": "We want to actually do it."
 },
 {
  "i": 21,
  "start": 34.98,
  "end": 36.6,
  "text": "Real friends, not perfect copies."
 },
 {
  "i": 22,
  "start": 36.98,
  "end": 38.72,
  "text": "A real life, not a really good dream."
 },
 {
  "i": 23,
  "start": 39.06,
  "end": 39.82,
  "text": "But here's the twist."
 },
 {
  "i": 24,
  "start": 40.2,
  "end": 43.94,
  "text": "In a later study, people were told their life, right now, is already the machine."
 },
 {
  "i": 25,
  "start": 44.24,
  "end": 46.8,
  "text": "Would they unplug, and wake up to a world they've never seen?"
 },
 {
  "i": 26,
  "start": 47.4,
  "end": 48.34,
  "text": "Many chose to stay."
 },
 {
  "i": 27,
  "start": 48.66,
  "end": 50.14,
  "text": "So maybe it's not about what's real."
 },
 {
  "i": 28,
  "start": 50.42,
  "end": 51.74,
  "text": "It's about what we're afraid to lose."
 },
 {
  "i": 29,
  "start": 52.14,
  "end": 52.8,
  "text": "Would you plug in?"
 },
 {
  "i": 30,
  "start": 53.16,
  "end": 54.1,
  "text": "Comment yes or no."
 }
]