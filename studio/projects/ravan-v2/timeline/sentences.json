[
 {
  "i": 0,
  "start": 0.05,
  "end": 1.85,
  "text": "Every year, you burn me."
 },
 {
  "i": 1,
  "start": 1.85,
  "end": 2.39,
  "text": "Ten heads."
 },
 {
  "i": 2,
  "start": 2.67,
  "end": 3.53,
  "text": "Fireworks inside."
 },
 {
  "i": 3,
  "start": 3.93,
  "end": 5.01,
  "text": "Millions of you, cheering."
 },
 {
  "i": 4,
  "start": 5.69,
  "end": 6.39,
  "text": "But tell me..."
 },
 {
  "i": 5,
  "start": 6.79,
  "end": 8.21,
  "text": "what if the arrow had missed?"
 },
 {
  "i": 6,
  "start": 8.91,
  "end": 9.11,
  "text": "Wait."
 },
 {
  "i": 7,
  "start": 9.65,
  "end": 9.93,
  "text": "Ravana..."
 },
 {
  "i": 8,
  "start": 9.93,
  "end": 10.59,
  "text": "won?"
 },
 {
  "i": 9,
  "start": 11.11,
  "end": 12.51,
  "text": "In one universe, yes."
 },
 {
  "i": 10,
  "start": 12.99,
  "end": 14.17,
  "text": "And this is his Lanka."
 },
 {
  "i": 11,
  "start": 14.59,
  "end": 16.39,
  "text": "In the year 2026."
 },
 {
  "i": 12,
  "start": 16.39,
  "end": 17.63,
  "text": "Chapter one."
 },
 {
  "i": 13,
  "start": 17.63,
  "end": 18.63,
  "text": "The city of gold."
 },
 {
  "i": 14,
  "start": 19.31,
  "end": 21.77,
  "text": "The Ramayan describes it as Swarna Lanka."
 },
 {
  "i": 15,
  "start": 22.31,
  "end": 29.09,
  "text": "A city of gold, built by Vishwakarma, the architect of the gods, on an island guarded by the ocean itself."
 },
 {
  "i": 16,
  "start": 29.09,
  "end": 31.19,
  "text": "But wasn't Ravana just..."
 },
 {
  "i": 17,
  "start": 31.19,
  "end": 31.97,
  "text": "the villain?"
 },
 {
  "i": 18,
  "start": 32.61,
  "end": 33.17,
  "text": "Not just."
 },
 {
  "i": 19,
  "start": 33.45,
  "end": 36.15,
  "text": "In the stories, Ravana was a scholar."
 },
 {
  "i": 20,
  "start": 36.53,
  "end": 37.69,
  "text": "A master of the veena."
 },
 {
  "i": 21,
  "start": 38.03,
  "end": 42.79,
  "text": "A devotee of Shiva so intense, legend says he tried to lift Mount Kailash."
 },
 {
  "i": 22,
  "start": 43.03,
  "end": 47.13,
  "text": "The Shiva Tandav Stotram, still chanted today, is credited to him."
 },
 {
  "i": 23,
  "start": 47.73,
  "end": 49.35,
  "text": "So imagine that mind..."
 },
 {
  "i": 24,
  "start": 49.35,
  "end": 49.87,
  "text": "winning."
 },
 {
  "i": 25,
  "start": 50.49,
  "end": 51.61,
  "text": "Chapter two."
 },
 {
  "i": 26,
  "start": 51.61,
  "end": 52.13,
  "text": "The empire."
 },
 {
  "i": 27,
  "start": 53.73,
  "end": 59.25,
  "text": "By the year one thousand, Lanka controls every sea route between Africa and China."
 },
 {
  "i": 28,
  "start": 59.55,
  "end": 60.87,
  "text": "Spice, silk, gold."
 },
 {
  "i": 29,
  "start": 61.09,
  "end": 62.91,
  "text": "All of it pays a toll to one island."
 },
 {
  "i": 30,
  "start": 63.43,
  "end": 65.51,
  "text": "And then, the Pushpak Vimaan."
 },
 {
  "i": 31,
  "start": 66.03,
  "end": 69.15,
  "text": "In the epic, a flying chariot that moves by thought."
 },
 {
  "i": 32,
  "start": 69.63,
  "end": 74.33,
  "text": "In this world, Lankan engineers spend two thousand years rebuilding it."
 },
 {
  "i": 33,
  "start": 75.29,
  "end": 79.07,
  "text": "By 2026, Lanka has the busiest skyport on Earth."
 },
 {
  "i": 34,
  "start": 79.07,
  "end": 82.93,
  "text": "Silent golden aircraft rise from the palace like fireflies."
 },
 {
  "i": 35,
  "start": 83.51,
  "end": 85.11,
  "text": "Okay, that part sounds amazing."
 },
 {
  "i": 36,
  "start": 85.71,
  "end": 86.91,
  "text": "And here's a real fact."
 },
 {
  "i": 37,
  "start": 87.61,
  "end": 94.09,
  "text": "In our world, Sri Lanka's first satellite, launched in 2019, was named after Ravana himself."
 },
 {
  "i": 38,
  "start": 94.69,
  "end": 96.91,
  "text": "Ten great towers stand around the palace."
 },
 {
  "i": 39,
  "start": 97.23,
  "end": 99.25,
  "text": "One for each of Ravana's heads."
 },
 {
  "i": 40,
  "start": 99.63,
  "end": 99.97,
  "text": "Medicine."
 },
 {
  "i": 41,
  "start": 100.35,
  "end": 100.67,
  "text": "Music."
 },
 {
  "i": 42,
  "start": 100.95,
  "end": 101.37,
  "text": "Astronomy."
 },
 {
  "i": 43,
  "start": 101.85,
  "end": 102.05,
  "text": "War."
 },
 {
  "i": 44,
  "start": 102.45,
  "end": 104.03,
  "text": "Ten minds, ruling as one."
 },
 {
  "i": 45,
  "start": 104.65,
  "end": 105.59,
  "text": "Chapter three."
 },
 {
  "i": 46,
  "start": 105.59,
  "end": 106.01,
  "text": "The shadow."
 },
 {
  "i": 47,
  "start": 106.01,
  "end": 106.85,
  "text": "So..."
 },
 {
  "i": 48,
  "start": 106.85,
  "end": 107.75,
  "text": "where's the catch?"
 },
 {
  "i": 49,
  "start": 108.59,
  "end": 109.77,
  "text": "There is no Dussehra here."
 },
 {
  "i": 50,
  "start": 110.03,
  "end": 111.89,
  "text": "No festival where good defeats pride."
 },
 {
  "i": 51,
  "start": 112.25,
  "end": 113.93,
  "text": "Children grow up with a different story."
 },
 {
  "i": 52,
  "start": 114.27,
  "end": 115.63,
  "text": "The strong take what they want."
 },
 {
  "i": 53,
  "start": 116.29,
  "end": 117.75,
  "text": "The ten towers watch everything."
 },
 {
  "i": 54,
  "start": 118.21,
  "end": 120.63,
  "text": "Disagree with the king, and you don't disappear."
 },
 {
  "i": 55,
  "start": 121.35,
  "end": 122.23,
  "text": "You're simply forgotten."
 },
 {
  "i": 56,
  "start": 122.99,
  "end": 127.95,
  "text": "And somewhere in the archives, there is a story nobody is allowed to tell."
 },
 {
  "i": 57,
  "start": 128.15,
  "end": 131.55,
  "text": "Of a woman taken from a forest, who never got to go home."
 },
 {
  "i": 58,
  "start": 131.97,
  "end": 133.53,
  "text": "So was he good, or bad?"
 },
 {
  "i": 59,
  "start": 134.07,
  "end": 135.17,
  "text": "That's the real question."
 },
 {
  "i": 60,
  "start": 135.17,
  "end": 136.61,
  "text": "Ravana was brilliant."
 },
 {
  "i": 61,
  "start": 136.89,
  "end": 137.29,
  "text": "Powerful."
 },
 {
  "i": 62,
  "start": 137.51,
  "end": 137.85,
  "text": "Devoted."
 },
 {
  "i": 63,
  "start": 138.25,
  "end": 139.39,
  "text": "And it still wasn't enough."
 },
 {
  "i": 64,
  "start": 139.57,
  "end": 142.87,
  "text": "Even his own brother, Vibhishana, warned him, and walked away."
 },
 {
  "i": 65,
  "start": 143.47,
  "end": 145.75,
  "text": "Maybe that's why the story needs him to lose."
 },
 {
  "i": 66,
  "start": 146.11,
  "end": 147.27,
  "text": "Not because he was weak."
 },
 {
  "i": 67,
  "start": 147.63,
  "end": 151.23,
  "text": "But because he was so strong, that only one flaw could bring him down."
 },
 {
  "i": 68,
  "start": 151.23,
  "end": 152.69,
  "text": "Pride."
 },
 {
  "i": 69,
  "start": 152.69,
  "end": 154.19,
  "text": "So you burn me every year..."
 },
 {
  "i": 70,
  "start": 154.71,
  "end": 156.45,
  "text": "...so that you never become me."
 },
 {
  "i": 71,
  "start": 157.01,
  "end": 157.67,
  "text": "So tell me."
 },
 {
  "i": 72,
  "start": 157.97,
  "end": 161.33,
  "text": "If Ravana had won, would you live in his golden Lanka?"
 },
 {
  "i": 73,
  "start": 161.91,
  "end": 163.21,
  "text": "Comment yes, or no."
 }
]